# ------------------------------------------------------------------
# Neuro Recode WhatsApp — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ------------------------------------------------------------------

# ---- Core ----
NODE_ENV=development

# ---- Deployment / TLS (used on the VPS by infra/init-letsencrypt.sh) ----
# Your domain/subdomain pointed at the VPS (A record). No http:// prefix.
DOMAIN=chat.neurorecode.com
# Email for Let's Encrypt expiry notices.
CERTBOT_EMAIL=admin@neurorecode.com

# In PRODUCTION set all three of these to your HTTPS domain, e.g.
#   API_PUBLIC_URL=https://chat.neurorecode.com
#   WEB_PUBLIC_URL=https://chat.neurorecode.com
#   CORS_ORIGINS=https://chat.neurorecode.com
# Public base URL of the API (must be HTTPS in production for Meta webhooks)
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the web app
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated origins allowed to call the API / open sockets
CORS_ORIGINS=http://localhost:3000

# ---- API server ----
API_PORT=4000

# ---- Postgres ----
POSTGRES_USER=nrw
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=nrw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma connection string (compose sets host=postgres)
DATABASE_URL=postgresql://nrw:change-me-postgres@localhost:5432/nrw?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Auth (JWT) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Initial admin agent seeded on first boot
SEED_ADMIN_EMAIL=admin@neurorecode.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ADMIN_NAME=Neuro Recode Admin

# ---- WhatsApp Business Cloud API (Meta) ----
# Graph API version, e.g. v21.0
GRAPH_API_VERSION=v21.0
# Permanent System-User access token
WHATSAPP_ACCESS_TOKEN=
# The phone number id (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# The WhatsApp Business Account (WABA) id
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta App id and secret (secret is used to verify webhook signatures)
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# A token you choose; must match what you enter in the Meta webhook config
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# ---- MinIO (S3-compatible media storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=nrw-minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=nrw-media
