{
  "name": "neuro-recode-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "Neuro Recode WhatsApp — custom agent inbox on the WhatsApp Business Cloud API",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter ./packages/* --filter ./apps/* build",
    "db:generate": "pnpm --filter @nrw/db generate",
    "db:migrate": "pnpm --filter @nrw/db migrate",
    "db:push": "pnpm --filter @nrw/db push",
    "db:seed": "pnpm --filter @nrw/db seed",
    "typecheck": "pnpm --filter ./apps/* --filter ./packages/* typecheck",
    "lint": "pnpm --filter ./apps/* --filter ./packages/* lint"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "@nestjs/core",
      "msgpackr-extract"
    ]
  }
}
